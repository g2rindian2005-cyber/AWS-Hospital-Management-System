# MediCore Hospital — backend image
# Runs the five Lambda handlers (unchanged) behind backend/local_server.py,
# a small stdlib adapter that speaks the API Gateway event format.
# Pair it with a MySQL container — see docker-compose.yml for the full stack.
#
#   docker build -f Dockerfile.backend -t medicore-hospital-backend .
#   docker run -p 8080:8080 -e DB_HOST=<mysql-host> -e DB_PASSWORD=<pw> medicore-hospital-backend
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PORT=8080

COPY backend/patient-lambda/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY backend/ /app/backend/

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz')" || exit 1

CMD ["python", "backend/local_server.py"]
